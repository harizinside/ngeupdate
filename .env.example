# Copy to .env (read by docker compose for variable substitution).
# DEPLOY_UID / DEPLOY_GID: `id deploy`   DOCKER_GID: `getent group docker | cut -d: -f3`
DEPLOY_UID=1000
DEPLOY_GID=1000
DOCKER_GID=999
# Image tag to pull (see README "Update" / "Rollback"). Defaults to `latest`
# when unset. Set to e.g. `sha-1a2b3c4` to pin or roll back.
NGEUPDATE_TAG=latest
