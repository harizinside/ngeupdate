# Copy to /etc/ngeupdate.env on the VPS, chmod 600, owner root.
# Generate a fresh key with:  openssl rand -hex 32
NGEUPDATE_KEY=
ALLOWED_ROOT=/srv/apps
PORT=8787
DEPLOY_TIMEOUT=1800
# Healthcheck window after `docker compose up -d`: poll every 5s, fail if
# services don't reach healthy twice in a row within this many seconds.
HEALTH_TIMEOUT=90
# Max deploys running at once across all projects (one per path is always enforced)
MAX_CONCURRENT_DEPLOYS=2
